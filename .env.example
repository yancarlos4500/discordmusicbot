DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id
# Optional: set for instant guild-scoped command deployment during development
GUILD_ID=
# Optional: JSON array of YouTube cookies, needed if playback fails with "Sign in to confirm you're not a bot"
# Can also be set at runtime via the /setcookies command instead (requires OWNER_ID below)
YT_COOKIES=
# Optional: your Discord user ID, required to use the /setcookies command
OWNER_ID=
